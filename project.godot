; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="渝见"
run/main_scene="res://scenes/opening_video.tscn"
config/features=PackedStringArray("4.7")

[autoload]

LevelManager="*res://autoload/level_manager.gd"
GameState="*res://autoload/game_state.gd"
DialogueSystem="*res://autoload/dialogue_system.gd"
AudioManager="*res://autoload/audio_manager.gd"
Accessibility="*res://autoload/accessibility.gd"
StoryDirector="*res://autoload/story_director.gd"
Companion="*res://autoload/companion.gd"
QuestGuide="*res://autoload/quest_guide.gd"
ChapterArrival="*res://autoload/chapter_arrival.gd"
YudengChat="*res://autoload/yudeng_chat.gd"
McpInteractionServer="*res://autoload/mcp_interaction_server.gd"
Skinner="*res://autoload/skinner.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"

